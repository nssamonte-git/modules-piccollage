# Shared rules: secrets, TLS validation, crypto (all platforms)
# Generated from the threat library cards (threats/shared/*); each rule cites its card.
# Fields (tab-separated, "-" = empty):
#   rule_id threat_id severity type file_globs pattern message card flags [exclude]
# Severity: high/critical block the build by default; medium/low warn.
# Heuristic rules are kept one level below the card severity so they warn.
SH-SEC-001	secrets-leakage	critical	match	*.kt;*.java;*.swift;*.m;*.mm;*.h;*.dart;*.js;*.jsx;*.ts;*.tsx;*.xml;*.plist;*.json;*.gradle;*.kts;*.properties;*.xcconfig;*.yaml;*.yml;*.env;.env;.env.*;*.pem;*.key;*.p8;*.cfg;*.conf;*.ini;*.toml;*.txt;*.sh;*.rb;Podfile;Fastfile;Matchfile;Appfile;*.c;*.cpp;*.cc;*.hpp	AKIA[0-9A-Z]{16}|(sk|rk)_live_[0-9A-Za-z]{16,}|ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{40,}|xox[baprs]-[0-9A-Za-z-]{10,}|-----BEGIN ((RSA|EC|DSA|OPENSSH|ENCRYPTED) )?PRIVATE KEY-----	Live credential or private key in the source tree: remove it, rotate it now, and load it from a secret store or CI secret at build/run time	shared/data-privacy/secrets-leakage.md	redact;gitignored-ok	EXAMPLE|AKIAIOSFODNN7
SH-SEC-002	secrets-leakage	medium	match	*.kt;*.java;*.swift;*.m;*.mm;*.h;*.dart;*.js;*.jsx;*.ts;*.tsx;*.xml;*.plist;*.json;*.gradle;*.kts;*.properties;*.xcconfig;*.yaml;*.yml;*.env;.env;.env.*;*.pem;*.key;*.p8;*.cfg;*.conf;*.ini;*.toml;*.txt;*.sh;*.rb;Podfile;Fastfile;Matchfile;Appfile;*.c;*.cpp;*.cc;*.hpp	AIza[0-9A-Za-z_-]{35}	Google API key embedded in the app: restrict it to this app (package + signing cert / bundle id) and API scope in Cloud Console, or move it to the Secrets Gradle Plugin / xcconfig	shared/data-privacy/secrets-leakage.md	redact;gitignored-ok;skippath=(^|/)(google-services\.json|GoogleService-Info\.plist)$
SH-SEC-003	secrets-leakage	high	imatch	*.kt;*.java;*.swift;*.m;*.mm;*.h;*.dart;*.js;*.jsx;*.ts;*.tsx;*.xcconfig;*.plist;*.yaml;*.yml	(api[_-]?key|apikey|secret[_-]?key|client[_-]?secret|secret|access[_-]?token|auth[_-]?token|token|passwd|password|private[_-]?key)["']?[[:space:]]*(:|=|:=|=>)[[:space:]]*@?["'][^"'[:space:]]{12,}["']	Hard-coded secret literal: anything shipped in the app can be extracted. Keep secrets on the server, or inject per-environment values at build time from an untracked source	shared/data-privacy/secrets-leakage.md	redact;gitignored-ok	\$\{|\$\(|\$[A-Z_]|process\.env|BuildConfig|getenv|YOUR_|[Yy]our[_-]|<[A-Za-z_ -]+>|[xX]{4}|\*{3}|[Ee]xample|EXAMPLE|[Pp]laceholder|[Cc]hange[_-]?[Mm]e|CHANGE_?ME|[Dd]ummy|REPLACE|[Rr]eplace[_-]?[Mm]e|R\.string|NSLocalizedString|Authorization|Bearer|application/|[:=][[:space:]]*@?["'][a-z]+[_.-][a-z_.-]*["']|AKIA[0-9A-Z]{16}|AIza|sk_live_|rk_live_|ghp_|github_pat_|xox[baprs]-
SH-SEC-004	secrets-leakage	high	imatch	*.xcconfig;*.properties;.env;.env.*;*.env	^[[:space:]]*(export[[:space:]]+)?[A-Za-z0-9_.-]*(api[_-]?key|secret|token|passwd|password|client[_-]?secret|private[_-]?key)[A-Za-z0-9_.-]*[[:space:]]*=[[:space:]]*["']?[^[:space:]"'$]{12,}	Secret value in a committed config/env file: move it out of the repository (untracked file, CI secret, or ~/.gradle/gradle.properties) and rotate it	shared/data-privacy/secrets-leakage.md	redact;gitignored-ok;skippath=(^|/)local\.properties$|\.(example|sample|template|dist)$	\$\(|\$\{|YOUR|[Yy]our[_-]|[xX]{4}|[Ee]xample|EXAMPLE|[Cc]hange[_-]?[Mm]e|REPLACE|<
SH-SEC-005	signing-key-theft	high	file	*.p12;*.pfx;*.p8;*.jks;*.keystore	-	Signing / push key material is committed: remove it from the repo (and git history), rotate it, and keep it in a vault or CI secret	shared/supply-chain/signing-key-theft.md	gitignored-ok;skippath=(^|/)debug\.keystore$
SH-SEC-006	signing-key-theft	high	imatch	Fastfile;Matchfile;Appfile;*.yml;*.yaml	(password|passphrase|p12_password|certificate_password|keychain_password|match_password)["']?[[:space:]]*(:|=|=>)[[:space:]]*["'][^"'$]{4,}["']	Signing or keychain password in CI/fastlane config: read it from ENV / CI secrets instead	shared/supply-chain/signing-key-theft.md	redact	ENV\[|ENV\.fetch|\$\{\{|secrets\.|vars\.
SH-TLS-001	incorrect-certificate-validation	critical	check	*.kt;*.java	within-absent;;checkServerTrusted\(;;(^|[^a-z])throw[[:space:]]|super\.checkServerTrusted|\.checkServerTrusted\(|[Vv]erif|[Vv]alidat|[Pp]inn|CertificatePinner	X509TrustManager.checkServerTrusted accepts every certificate: delete the custom TrustManager and use the platform default (pin with Network Security Config or CertificatePinner)	shared/crypto/incorrect-certificate-validation.md	-
SH-TLS-002	incorrect-certificate-validation	critical	match	*.kt;*.java	ALLOW_ALL_HOSTNAME_VERIFIER|NoopHostnameVerifier|hostnameVerifier[[:space:]]*(=[[:space:]]*)?\{[^}]*->[[:space:]]*true[[:space:]]*\}|HostnameVerifier[[:space:]]*\{[^}]*->[[:space:]]*true	HostnameVerifier accepts every host: remove it and keep the default verifier	shared/crypto/incorrect-certificate-validation.md	-
SH-TLS-003	incorrect-certificate-validation	critical	check	*.kt;*.java	within-absent;;(boolean|fun)[[:space:]]+verify\([^)]*SSLSession;;false|getDefaultHostnameVerifier|\.verify\(|OkHostnameVerifier	HostnameVerifier.verify never rejects a host: remove it and keep the default verifier	shared/crypto/incorrect-certificate-validation.md	-
SH-TLS-004	attacker-in-the-middle	medium	match	*.kt;*.java;*.swift;*.m;*.mm;*.h;*.dart;*.js;*.jsx;*.ts;*.tsx	["'`]http://[A-Za-z0-9]	Cleartext http:// endpoint: use https so traffic cannot be read or modified on the network	shared/network/attacker-in-the-middle.md	-	http://(localhost|127\.0\.0\.1|10\.0\.2\.2|10\.0\.3\.2|0\.0\.0\.0|\[::1\]|schemas\.android\.com|schemas\.microsoft\.com|www\.w3\.org|ns\.adobe\.com|purl\.org|xml\.org|www\.apple\.com/DTDs|example\.(com|org|net))
SH-CR-001	improper-encryption-mode	high	match	*.kt;*.java;*.swift;*.m;*.mm;*.h;*.dart;*.js;*.jsx;*.ts;*.tsx	"AES/ECB|Cipher\.getInstance\([[:space:]]*"AES"[[:space:]]*\)|kCCOptionECBMode|AESMode\.ecb|mode\.ECB|["']aes-[0-9]+-ecb	ECB mode (or bare "AES", which defaults to ECB) leaks plaintext patterns: use AES/GCM/NoPadding with a random 12-byte nonce (CryptoKit AES.GCM on iOS)	shared/crypto/improper-encryption-mode.md	-
SH-CR-002	weak-obsolete-algorithms	high	match	*.kt;*.java;*.swift;*.m;*.mm;*.h;*.dart;*.js;*.jsx;*.ts;*.tsx	Cipher\.getInstance\([[:space:]]*"(DES|DESede|RC4|ARCFOUR|Blowfish|RC2)[/"]|kCCAlgorithm(DES|3DES|RC4|RC2|Blowfish)|CryptoJS\.(DES|TripleDES|RC4|Rabbit)|["'](des|des-ede3|rc4)(-cbc|-ecb)?["']	Broken cipher (DES/3DES/RC4/RC2/Blowfish): replace with AES-GCM or ChaCha20-Poly1305	shared/crypto/weak-obsolete-algorithms.md	-
SH-CR-003	weak-obsolete-algorithms	medium	match	*.kt;*.java;*.swift;*.m;*.mm;*.h;*.dart;*.js;*.jsx;*.ts;*.tsx	MessageDigest\.getInstance\([[:space:]]*"(MD5|SHA-?1)"|CC_MD5\(|CC_SHA1\(|Insecure\.(MD5|SHA1)|(md5|sha1)\.convert\(|CryptoJS\.(MD5|SHA1)\(|createHash\([[:space:]]*["'](md5|sha1)	MD5/SHA-1 must not protect integrity, signatures or passwords: use SHA-256+ (and a password KDF for passwords)	shared/crypto/weak-obsolete-algorithms.md	-
SH-CR-004	hardcoded-encryption-keys	high	match	*.kt;*.java;*.swift;*.m;*.mm;*.h;*.dart;*.js;*.jsx;*.ts;*.tsx	SecretKeySpec\([[:space:]]*("[^"]*"|[A-Z][A-Z0-9_]*)\.(toByteArray|getBytes)|SecretKeySpec\([[:space:]]*(byteArrayOf\(|new[[:space:]]+byte\[\][[:space:]]*\{)|SymmetricKey\(data:[[:space:]]*(Data\([[:space:]]*)?("|\[[[:space:]]*(0x|[0-9]))|Key\.from(Utf8|Base64)\([[:space:]]*["']|CryptoJS\.AES\.(en|de)crypt\([^,]+,[[:space:]]*["'][^"']{6,}["']	Encryption key is a literal in the source: generate keys in Android Keystore / iOS Keychain or Secure Enclave, never embed them	shared/crypto/hardcoded-encryption-keys.md	-
SH-CR-005	iv-nonce-reuse	high	match	*.kt;*.java;*.swift;*.m;*.mm;*.h;*.dart;*.js;*.jsx;*.ts;*.tsx	IvParameterSpec\([[:space:]]*("|ByteArray\([0-9]+\)|new[[:space:]]+byte\[[0-9]+\]|[A-Z][A-Z0-9_]*\.(toByteArray|getBytes)|byteArrayOf\()|IV\.fromUtf8\([[:space:]]*["']|IV\.fromLength\(|IV\.allZerosOfLength\(	Fixed or zero IV/nonce: generate a fresh random IV for every encryption and store it with the ciphertext	shared/crypto/iv-nonce-reuse.md	-
